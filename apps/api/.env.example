# Salin ke apps/api/.env — jangan commit .env
# Nilai kosong di env.ts TIDAK diisi hardcode; isi di file ini.

NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/sintesa

# Session lokal SINTESA (bukan secret IdP)
JWT_SECRET=ganti-dengan-random-min-32-karakter
JWT_EXPIRES_IN=8h
COOKIE_NAME=sintesa_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Kredensia IdP (wajib diisi dari panel IdP, tidak ada default rahasia) ---
SSO_BASE_URL=https://sso-v2.smage.my.id
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=http://localhost:3001/api/auth/sso/callback
# Verifikasi JWT callback; jika kosong dipakai SSO_CLIENT_SECRET
SSO_JWT_SECRET=
# Opsional: Kunci API read-only /api/v1/*
SSO_API_KEY=
# Opsional override; kosong = {SSO_BASE_URL}/api/v1
SSO_API_BASE_URL=

LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW_MS=600000

# GDS — Poin Kedisiplinan (app terpisah, coming soon)
GDS_BASE_URL=
GDS_API_KEY=

# Kehadiran Siswa (app terpisah, coming soon)
KEHADIRAN_BASE_URL=
KEHADIRAN_API_KEY=

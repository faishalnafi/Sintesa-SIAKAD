# Copy values into apps/api/.env and apps/web/.env
# Never commit real secrets.

# --- apps/api/.env ---
# NODE_ENV=development
# PORT=3001
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/sintesa
# JWT_SECRET=change-me-long-random
# JWT_EXPIRES_IN=8h
# COOKIE_NAME=sintesa_session
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax
# FRONTEND_URL=http://localhost:5173
# CORS_ORIGINS=http://localhost:5173
# SSO_BASE_URL=http://localhost:8000
# SSO_APP_ID=
# SSO_REDIRECT_URI=http://localhost:3001/api/auth/sso/callback
# SSO_JWT_SECRET=
# SSO_API_KEY=
# SSO_API_BASE_URL=http://localhost:8000/api/v1

# --- apps/web/.env ---
# VITE_API_BASE_URL=http://localhost:3001/api
# VITE_APP_NAME=SINTESA

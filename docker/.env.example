# Salin ke root repo: cp docker/.env.example .env
# Atau generate otomatis: ./scripts/generate-stack-env.sh https://domain-anda
# Panduan stack Portainer/Dokploy: deploy-to-docker.md

# --- WAJIB (3 nilai ini harus diganti) ---
PUBLIC_URL=https://sintesa.sekolah.sch.id
JWT_SECRET=ganti-dengan-random-min-32-karakter
POSTGRES_PASSWORD=ganti-password-kuat

# --- WAJIB untuk stack (samakan dengan PUBLIC_URL) ---
CORS_ORIGINS=https://sintesa.sekolah.sch.id
SSO_REDIRECT_URI=https://sintesa.sekolah.sch.id/api/auth/sso/callback

# --- Opsional umum ---
POSTGRES_USER=sintesa
POSTGRES_DB=sintesa
HTTP_PORT=8080
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
RUN_DB_SEED=false
SINTESA_IMAGE_TAG=latest

# --- Kredensia SSO (isi dari panel IdP) ---
SSO_BASE_URL=https://sso-v2.smage.my.id
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_JWT_SECRET=
SSO_API_KEY=

# --- Integrasi (opsional, kosongkan jika belum dipakai) ---
GDS_BASE_URL=
GDS_API_KEY=
KEHADIRAN_BASE_URL=
KEHADIRAN_API_KEY=